# Generated: rebuilt by npm install, npm run build and the tests. The same folders are left out of Prettier
# (.prettierignore), ESLint (eslint.config.js) and TypeScript (tsconfig.json).
node_modules/
dist/
.astro/
.wrangler/
test-results/
playwright-report/

# Secrets and this machine's settings: never in git. Copy .env.example to .env for local settings;
# Cloudflare's local secrets go in .dev.vars.
.env
.env.*
!.env.example
.dev.vars
*.local
*.pem
*.key
*.p12

# Editor and system files; the project's recommended extensions stay shared
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
npm-debug.log*
