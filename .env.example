# Local settings for this machine. Copy this file to .env (git leaves .env out) and change what you need.
# The site itself reads no secrets: everything it shows is in src/config/site.ts.

# The port the end-to-end tests serve the built site on (playwright.config.ts). Change it when your own
# `npm run dev` already holds 4321.
E2E_PORT=4321
