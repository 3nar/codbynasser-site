---
/**
 * The spectrum: black walks to light one step of grey at a time (after the problems on the home page), or back
 * into the dark before every closing section (reverse). spectrum.ts unrolls it on scroll.
 */
interface Props {
  reverse?: boolean;
}
const { reverse = false } = Astro.props;
const greys = ['#1C1C1E', '#2C2C2E', '#3A3A3C', '#48484A', '#636366', '#8E8E93', '#AEAEB2', '#C7C7CC', '#D2D2D7', '#E8E8ED'];
const steps = reverse ? [...greys].reverse() : greys;
---

<div class={reverse ? 'spectrum rev' : 'spectrum'} id={reverse ? undefined : 'spectrum'} data-stage={reverse ? 'light' : 'dark'} aria-hidden="true">
    {steps.map((grey) => <i style={`background:${grey}`}></i>)}
  </div>
