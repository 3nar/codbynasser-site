---
/**
 * The first screen of an inner page: the aura (or liquid light) behind, the copy in front.
 * Slots: `aura` for the light, the default slot for the copy (switch, heading, line, action).
 */
interface Props {
  tone: 'light' | 'dark';
}
const { tone } = Astro.props;
---

<section class={`page-hero ${tone}`} id="top" data-stage={tone} aria-labelledby="page-title">
    <slot name="aura" />
    <div class="wrap"><div class="copy">
      <slot />
    </div></div>
  </section>
