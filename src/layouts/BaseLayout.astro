---
/**
 * The frame every page shares: head, skip link, header, the page's content in <main>, footer, the phone's
 * request bar, and the behaviour (src/scripts/main.ts). Pages pass their title and description.
 */
import '@/styles/index.css';
import Dock from '@/components/layout/Dock/Dock.astro';
import Footer from '@/components/layout/Footer/Footer.astro';
import Header from '@/components/layout/Header/Header.astro';
import SkipLink from '@/components/layout/SkipLink.astro';
import type { ServiceId } from '@/config/routes';
import { LOCALES, toLocale } from '@/i18n/config';
import Head from './partials/Head.astro';

interface Props {
  title: string;
  description: string;
  preloadImage?: string;
  current?: 'request';
  /** the service a service page is about: every request button on the page keeps it */
  service?: ServiceId;
}
const { title, description, preloadImage, current, service } = Astro.props;
const locale = toLocale(Astro.currentLocale);
---

<!doctype html>
<html lang={locale} dir={LOCALES[locale].dir}>
<head>
<Head title={title} description={description} preloadImage={preloadImage} />
</head>
<body>
<SkipLink />

<Header current={current} service={service} />

<main id="main">
<slot />
</main>

<Footer />

<Dock service={service} />

<script>
  import '@/scripts/main';
</script>
</body>
</html>
